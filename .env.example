# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MySQL Database Configuration
DB_HOST="localhost"
DB_PORT=3306
DB_USER="root"
DB_PASSWORD=""
DB_NAME="watchwds"

# JWT Secret Key
# Generate a strong random key: openssl rand -hex 32
JWT_SECRET="your-strong-random-jwt-secret-key-here"

# API v1 — Bearer token for third-party service authentication
# Generate a strong random token: openssl rand -hex 32
API_BEARER_TOKEN="your-secure-api-token-here"

# Mux Video & Live Streaming (Server-side only — never expose secrets to frontend)
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
MUX_WEBHOOK_SECRET=""
# Mux Signed Playback Keys (for token-protected live streams & VODs; PEM or Base64-encoded PEM)
MUX_SIGNING_KEY_ID=""
MUX_SIGNING_PRIVATE_KEY=""
# Optional custom RTMP ingest URL override (defaults to rtmps://global-live.mux.com:443/app)
# MUX_RTMP_INGEST_URL="rtmps://global-live.mux.com:443/app"
# Optional dedicated 32+ char key for AES-256-GCM encryption of reusable club stream keys (falls back to JWT_SECRET derivation)
# MUX_ENCRYPTION_KEY=""
